
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#35151e">

    <title>dear Nữ. — Anonymous Mailbox</title>

    <meta name="description" content="A little place for your words. Send an anonymous letter to Nữ.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">

    <style>
        /* =================================
           01. ROOT VARIABLES
        ================================= */

        :root {
            --wine: #4a1925;
            --wine-dark: #291017;
            --wine-light: #713c49;
            --wine-soft: #a4777c;

            --paper: #f5eee5;
            --paper-light: #fbf7f0;
            --paper-dark: #e8ddd0;

            --ink: #39262a;
            --muted: #a18d8a;

            --border: rgba(74, 25, 37, .15);

            --serif: 'Playfair Display', serif;
            --sans: 'DM Sans', sans-serif;
        }

        /* =================================
           02. RESET
        ================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            font-family: var(--sans);
            color: var(--ink);
            background: var(--wine-dark);
            overflow-x: hidden;
        }

        button,
        textarea {
            font-family: inherit;
        }

        button {
            -webkit-tap-highlight-color: transparent;
        }

        /* =================================
           03. BACKGROUND
        ================================= */

        .background {
            position: fixed;
            inset: 0;
            z-index: -2;

            background:
                radial-gradient(
                    ellipse at 50% 15%,
                    rgba(119, 57, 73, .55),
                    transparent 55%
                ),
                linear-gradient(
                    145deg,
                    #211016,
                    #39151f 55%,
                    #1f0c12
                );
        }

        .background::after {
            content: "";
            position: absolute;
            inset: 0;

            opacity: .12;

            background-image:
                url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.22'/%3E%3C/svg%3E");
            pointer-events: none;
        }

        /* =================================
           04. PAGE LAYOUT
        ================================= */

        .page {
            width: 100%;
            min-height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;

            padding: 55px 20px;
        }

        .container {
            width: 100%;
            max-width: 620px;
        }

        /* =================================
           05. TOP BRAND
        ================================= */

        .top-brand {
            text-align: center;
            margin-bottom: 28px;
            animation: fadeUp .8s ease both;
        }

        .brand-name {
            font-family: var(--serif);
            font-size: 34px;
            font-weight: 600;
            letter-spacing: -.8px;
            color: #f4e9df;
        }

        .brand-name span {
            color: #b98688;
        }

        .brand-subtitle {
            margin-top: 8px;
            font-size: 9px;
            letter-spacing: 4px;
            color: rgba(245, 238, 229, .48);
            text-transform: uppercase;
        }

        /* =================================
           06. PAPER CARD
        ================================= */

        .paper {
            position: relative;
            width: 100%;

            background:
                linear-gradient(
                    145deg,
                    var(--paper-light),
                    var(--paper)
                );

            padding: 55px 55px 38px;

            border: 1px solid rgba(255,255,255,.3);

            box-shadow:
                0 30px 90px rgba(0,0,0,.3),
                0 5px 20px rgba(0,0,0,.15);

            animation: fadeUp 1s ease both;
        }

        .paper::before {
            content: "";
            position: absolute;
            inset: 11px;

            border: 1px solid var(--border);

            pointer-events: none;
        }

        .paper::after {
            content: "";
            position: absolute;

            width: 45px;
            height: 45px;

            right: 25px;
            top: 25px;

            border-top: 1px solid rgba(74,25,37,.18);
            border-right: 1px solid rgba(74,25,37,.18);
        }

        /* =================================
           07. MAIL SYMBOL
        ================================= */

        .mail-symbol {
            display: flex;
            justify-content: center;
            margin-bottom: 22px;
        }

        .mail-symbol svg {
            width: 43px;
            height: 43px;

            stroke: var(--wine-light);
            stroke-width: 1.1;
            fill: none;
        }

        /* =================================
           08. HEADING
        ================================= */

        .eyebrow {
            text-align: center;

            font-size: 9px;
            font-weight: 600;
            letter-spacing: 4px;

            color: var(--wine-soft);
            text-transform: uppercase;

            margin-bottom: 17px;
        }

        .heading {
            font-family: var(--serif);
            font-weight: 500;

            font-size: clamp(30px, 6vw, 43px);

            text-align: center;
            line-height: 1.25;

            color: var(--wine);
        }

        .heading em {
            font-weight: 400;
        }

        .description {
            max-width: 380px;

            margin: 17px auto 35px;

            font-size: 12px;
            line-height: 2;

            text-align: center;

            color: #897577;
        }

        /* =================================
           09. FORM
        ================================= */

        .letter-form {
            width: 100%;
        }

        .textarea-wrapper {
            position: relative;
        }

        .letter-input {
            width: 100%;
            min-height: 190px;

            display: block;

            padding: 20px;

            resize: vertical;

            border: 1px solid var(--border);
            border-radius: 0;

            outline: none;

            background: rgba(255,255,255,.35);

            font-size: 13px;
            line-height: 1.9;

            color: var(--ink);

            transition:
                border .25s,
                background .25s;
        }

        .letter-input:focus {
            border-color: var(--wine-light);
            background: rgba(255,255,255,.65);
        }

        .letter-input::placeholder {
            color: #b19fa0;
            font-family: var(--serif);
            font-style: italic;
        }

        /* =================================
           10. FORM INFORMATION
        ================================= */

        .form-information {
            display: flex;
            justify-content: space-between;
            align-items: center;

            margin-top: 11px;
            margin-bottom: 25px;

            font-size: 10px;
            color: var(--muted);
        }

        .anonymous-label {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .anonymous-dot {
            width: 5px;
            height: 5px;

            background: #8e5963;
            border-radius: 50%;
        }

        /* =================================
           11. SEND BUTTON
        ================================= */

        .send-button {
            width: 100%;
            height: 53px;

            border: none;
            border-radius: 0;

            background: var(--wine);
            color: var(--paper-light);

            font-size: 11px;
            font-weight: 600;
            letter-spacing: 2px;

            cursor: pointer;

            display: flex;
            justify-content: center;
            align-items: center;
            gap: 13px;

            transition:
                background .3s,
                transform .3s,
                box-shadow .3s;
        }

        .send-button:hover {
            background: var(--wine-light);
            box-shadow: 0 8px 25px rgba(74,25,37,.18);
        }

        .send-button:active {
            transform: scale(.985);
        }

        .send-button:disabled {
            opacity: .65;
            cursor: wait;
        }

        .send-arrow {
            font-size: 16px;
            font-weight: 400;
        }

        /* =================================
           12. STATUS MESSAGE
        ================================= */

        .status {
            min-height: 24px;

            margin-top: 16px;

            text-align: center;
            font-size: 11px;

            color: var(--wine-light);
        }

        .status.error {
            color: #a13b3b;
        }

        .status.success {
            color: #53745c;
        }

        /* =================================
           13. FOOTER
        ================================= */

        .footer {
            margin-top: 32px;
            text-align: center;
        }

        .footer-line {
            width: 35px;
            height: 1px;

            margin: 0 auto 15px;

            background: rgba(74,25,37,.25);
        }

        .footer-text {
            font-family: var(--serif);
            font-style: italic;

            font-size: 12px;
            color: #a18d8a;
        }

        .footer-copy {
            margin-top: 12px;

            font-size: 9px;
            letter-spacing: 2px;

            color: #b6a6a0;
        }

        /* =================================
           14. SUCCESS OVERLAY
        ================================= */

        .success-overlay {
            position: fixed;
            inset: 0;
            z-index: 20;

            display: none;
            justify-content: center;
            align-items: center;

            padding: 20px;

            background: rgba(25, 8, 13, .78);
            backdrop-filter: blur(7px);
        }

        .success-overlay.show {
            display: flex;
            animation: fadeIn .3s ease;
        }

        .success-card {
            width: 100%;
            max-width: 390px;

            padding: 45px 30px;

            text-align: center;

            background: var(--paper);
            border: 1px solid rgba(255,255,255,.3);

            animation: fadeUp .4s ease;
        }

        .success-icon {
            font-family: var(--serif);
            font-size: 40px;
            color: var(--wine-light);
        }

        .success-title {
            margin-top: 17px;

            font-family: var(--serif);
            font-size: 29px;
            font-weight: 500;

            color: var(--wine);
        }

        .success-description {
            margin-top: 12px;

            font-size: 12px;
            line-height: 1.9;

            color: #897577;
        }

        .close-success {
            margin-top: 27px;

            padding: 13px 30px;

            background: var(--wine);
            color: var(--paper);

            border: none;
            cursor: pointer;

            font-size: 10px;
            letter-spacing: 2px;
        }

        /* =================================
           15. ANIMATION
        ================================= */

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        /* =================================
           16. RESPONSIVE
        ================================= */

        @media (max-width: 600px) {

            .page {
                padding: 35px 15px;
            }

            .paper {
                padding: 43px 25px 30px;
            }

            .brand-name {
                font-size: 30px;
            }

            .heading {
                font-size: 33px;
            }

            .description {
                font-size: 11px;
                margin-bottom: 28px;
            }

            .letter-input {
                min-height: 180px;
                font-size: 12px;
            }

            .paper::after {
                width: 30px;
                height: 30px;
                right: 19px;
                top: 19px;
            }
        }

        @media (max-width: 350px) {

            .paper {
                padding: 38px 19px 25px;
            }

            .heading {
                font-size: 29px;
            }

            .form-information {
                font-size: 9px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: .01ms !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
</head>

<body>

    <div class="background"></div>

    <main class="page">

        <div class="container">

            <!-- BRAND -->

            <header class="top-brand">

                <div class="brand-name">
                    dear <span>Nữ.</span>
                </div>

                <div class="brand-subtitle">
                    ANONYMOUS MAILBOX
                </div>

            </header>


            <!-- MAIN PAPER -->

            <section class="paper">

                <!-- MAIL ICON -->

                <div class="mail-symbol">

                    <svg viewBox="0 0 48 48">
                        <rect
                            x="5"
                            y="10"
                            width="38"
                            height="28"
                            rx="1"
                        />

                        <path d="M6 12 L24 26 L42 12"/>

                        <path d="M6 36 L18 25"/>
                        <path d="M42 36 L30 25"/>
                    </svg>

                </div>


                <!-- INTRODUCTION -->

                <div class="eyebrow">
                    A private little corner
                </div>

                <h1 class="heading">
                    Gửi Nữ một<br>
                    <em>lá thư.</em>
                </h1>

                <p class="description">
                    Có điều gì muốn nói với Nữ?
                    Một lời nhắn, một câu chuyện,
                    một suy nghĩ bất chợt hay bất cứ điều gì
                    bạn muốn gửi gắm.
                    Cứ viết ra nhé.
                </p>


                <!-- FORM -->

                <form class="letter-form" id="letterForm">

                    <div class="textarea-wrapper">

                        <textarea
                            class="letter-input"
                            id="letterContent"
                            name="content"
                            maxlength="5000"
                            placeholder="Dear Nữ, ..."
                            required
                            aria-label="Nội dung thư"
                        ></textarea>

                    </div>


                    <!-- COUNTER -->

                    <div class="form-information">

                        <div class="anonymous-label">
                            <span class="anonymous-dot"></span>
                            <span>Anonymous message</span>
                        </div>

                        <div>
                            <span id="charCount">0</span> / 5000
                        </div>

                    </div>


                    <!-- BUTTON -->

                    <button
                        class="send-button"
                        type="submit"
                        id="sendButton"
                    >
                        <span>GỬI THƯ</span>
                        <span class="send-arrow">↗</span>
                    </button>


                    <!-- STATUS -->

                    <div
                        class="status"
                        id="statusMessage"
                        role="status"
                        aria-live="polite"
                    ></div>

                </form>


                <!-- FOOTER -->

                <footer class="footer">

                    <div class="footer-line"></div>

                    <p class="footer-text">
                        A little place for your words.
                    </p>

                    <p class="footer-copy">
                        DEAR NỮ. © 2026
                    </p>

                </footer>

            </section>

        </div>

    </main>


    <!-- SUCCESS POPUP -->

    <div class="success-overlay" id="successOverlay">

        <div class="success-card">

            <div class="success-icon">✉</div>

            <h2 class="success-title">
                Thư đã được gửi.
            </h2>

            <p class="success-description">
                Cảm ơn bạn đã dành chút thời gian
                để viết những dòng này.
                Nữ sẽ nhận được lá thư của bạn.
            </p>

            <button
                class="close-success"
                id="closeSuccess"
                type="button"
            >
                ĐÓNG
            </button>

        </div>

    </div>


    <!-- JAVASCRIPT -->

    <script>

        const form = document.getElementById("letterForm");

        const content = document.getElementById("letterContent");

        const count = document.getElementById("charCount");

        const button = document.getElementById("sendButton");

        const status = document.getElementById("statusMessage");

        const overlay = document.getElementById("successOverlay");

        const closeSuccess = document.getElementById("closeSuccess");


        // CHARACTER COUNTER

        content.addEventListener("input", function () {

            count.textContent = content.value.length;

        });


        // SEND LETTER

        form.addEventListener("submit", async function (event) {

            event.preventDefault();

            const message = content.value.trim();

            if (!message) {

                status.textContent = "Bạn chưa viết nội dung thư.";

                status.className = "status error";

                return;

            }

            if (message.length > 5000) {

                status.textContent = "Nội dung thư quá dài.";

                status.className = "status error";

                return;

            }


            /*
                CHƯA KẾT NỐI DATABASE.

                Khi kết nối Supabase, thay phần xử lý
                bên dưới bằng lệnh INSERT vào bảng letters.

                Không hiển thị thông báo thành công giả
                khi chưa lưu thư trực tuyến.
            */

            status.textContent =
                "Giao diện đã sẵn sàng. Cần kết nối máy chủ để gửi thư.";

            status.className = "status";

        });


        // CLOSE SUCCESS POPUP

        closeSuccess.addEventListener("click", function () {

            overlay.classList.remove("show");

        });


        // CLOSE WHEN CLICK OUTSIDE

        overlay.addEventListener("click", function (event) {

            if (event.target === overlay) {

                overlay.classList.remove("show");

            }

        });

    </script>

</body>
</html>
